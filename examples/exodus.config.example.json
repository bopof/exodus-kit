{
  "_comment": "Copy to exodus.config.json (git-ignored) and edit. Keys starting with _ are ignored.",
  "prefix": "exo",
  "default_user": "alice",
  "user_map": {
    "alice": "alice",
    "SYSTEM": "root"
  },
  "path_map": {
    "C:\\Users\\Alice": "/home/alice",
    "D:\\Data": "/srv/data"
  },
  "_exclude": "Vendor updaters/utilities are left out by default (see DEFAULT_EXCLUDES; REPORT.md lists what was left out). exclude_extra leaves out more; keep ports an item the defaults leave out; exclude replaces the defaults.",
  "exclude_extra": ["\\MyOldStuff\\*", "service:Spooler"],
  "keep": ["service:Steam Client Service"],
  "after": ["network-online.target"],
  "trusted_interface": "tailscale0",
  "persistent": true,
  "exec_map": {
    "\\Nightly Backup": {
      "exec": "/usr/bin/rsync -a --delete /home/alice/Documents/ /mnt/nas/backup/Documents/",
      "requires_mounts_for": ["/mnt/nas/backup"]
    },
    "\\MyApp\\Daily Collect": {
      "exec": "/home/alice/projects/myapp/.venv/bin/python collect.py --delay 120",
      "workdir": "/home/alice/projects/myapp",
      "user": "alice",
      "environment": { "TZ": "Europe/Paris" },
      "credentials": ["api-token:/etc/myapp/api.token"]
    },
    "service:MyDashboard": {
      "exec": "/home/alice/projects/myapp/.venv/bin/python -m streamlit run dashboard.py --server.port 8501",
      "workdir": "/home/alice/projects/myapp",
      "after": ["remote-fs.target"]
    }
  }
}
